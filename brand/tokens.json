{
  "$comment": "bigd. brand tokens — SOURCE OF TRUTH. Edit here, then run: python -E -P tools/build_kit.py (regenerates tokens.css, tailwind.preset.js, bigd-mark.js, logos, icons).",
  "version": "1.0.0",
  "locked": "2026-10-18",
  "color": {
    "ink": "#0b0b0c",
    "bone": "#f4f3ef",
    "white": "#ffffff",
    "graphite": "#6b6b70",
    "line": "#e2e0da",
    "chip": "#eceae4",
    "night": {
      "bg": "#0f0f10",
      "panel": "#18181a",
      "text": "#f4f3ef",
      "muted": "#9c9ca3",
      "line": "#2a2a2e",
      "chip": "#222225"
    }
  },
  "lights": {
    "green":  { "hex": "#00b371", "onLight": "#007d4f", "onDark": "#00b371" },
    "coral":  { "hex": "#ff5a4e", "onLight": "#c2362b", "onDark": "#ff6b60" },
    "blue":   { "hex": "#3b6cff", "onLight": "#2556e6", "onDark": "#7b9bff" },
    "amber":  { "hex": "#ffb020", "onLight": "#8f5c00", "onDark": "#ffb020" },
    "violet": { "hex": "#8b5cf6", "onLight": "#7344e3", "onDark": "#a68bff" }
  },
  "apps": {
    "bigd":    { "name": "BigD",    "light": "green",  "note": "the hub and the company mark" },
    "darts":   { "name": "Darts",   "light": "coral" },
    "dice":    { "name": "Dice",    "light": "blue" },
    "cards":   { "name": "Cards",   "light": "amber" },
    "shoebox": { "name": "Shoebox", "light": "violet" }
  },
  "fullHouse": { "tl": "blue", "tr": "green", "bl": "amber", "br": "coral", "$comment": "BigD Pass only" },
  "mark": {
    "$comment": "100-unit grid. Tiles occupy 16..84. Rule 1: only the top-right tile is lit, in the app's light. Full house (all four lit) = BigD Pass only.",
    "grid": 100,
    "inset": 16,
    "tile": 31,
    "gap": 6,
    "radius": 6,
    "litCorner": "tr",
    "minSizePx": 20,
    "faviconMaster": { "grid": 16, "inset": 2, "tile": 5, "gap": 2, "radius": 1.2, "bgRadius": 3.5 }
  },
  "font": {
    "sans": { "family": "Sora", "stack": "Sora, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif" },
    "mono": { "family": "JetBrains Mono", "stack": "'JetBrains Mono', ui-monospace, 'Cascadia Mono', Consolas, monospace" }
  },
  "wordmark": { "text": "bigd", "dot": ".", "weight": 700, "tracking": -0.055 },
  "type": {
    "display": { "size": 64, "line": 1.0,  "tracking": -0.045, "weight": 700 },
    "h1":      { "size": 48, "line": 1.04, "tracking": -0.04,  "weight": 700 },
    "h2":      { "size": 34, "line": 1.1,  "tracking": -0.03,  "weight": 700 },
    "h3":      { "size": 24, "line": 1.25, "tracking": -0.02,  "weight": 600 },
    "lead":    { "size": 18, "line": 1.6,  "tracking": -0.005, "weight": 400 },
    "body":    { "size": 16, "line": 1.6,  "tracking": 0,      "weight": 400 },
    "small":   { "size": 14, "line": 1.5,  "tracking": 0,      "weight": 400 },
    "label":   { "size": 12, "line": 1.3,  "tracking": 0.06,   "weight": 500, "mono": true, "upper": true }
  },
  "radius": { "sm": 8, "md": 12, "lg": 16, "xl": 20, "pill": 999 }
}
